@startuml
hide circle
hide empty members
skinparam classAttributeIconSize 0
package "Services" as Services <<profile>> {
  class Service <<stereotype>> {
    timeoutMs: Integer {>0}
  }
}
class Component <<metaclass>>
package "Модель магазина" as Shop {
  class PaymentService <<Service>> {
    {timeoutMs = 500}
  }
}
Service -right-|> Component : расширение
Shop .up.> Services : <<apply>>
@enduml
